generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  globalRole    GlobalRole @default(USER)
  phone         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts           Account[]
  sessions           Session[]
  storeMembers       StoreMember[]
  orders             Order[]
  reviews            Review[]
  cartItems          CartItem[]
  assignedProspects  Prospect[]         @relation("ProspectAssignee")
  prospectActivities ProspectActivity[] @relation("ProspectActivityActor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Location ────────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  state     String
  country   String   @default("MX")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stores Store[]

  @@map("cities")
}

// ─── Stores (Tenants) ────────────────────────────────────────────────────────

model Store {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  name                    String
  description             String?   @db.Text
  logoUrl                 String?
  bannerUrl               String?
  primaryColor            String?   @default("#000000")
  fontFamily              String?   @default("Inter")
  cityId                  String?
  city                    City?     @relation(fields: [cityId], references: [id])
  stripeAccountId         String?
  stripeCustomerId        String?
  stripeOnboarded         Boolean   @default(false)
  customDomain            String?   @unique
  isActive                Boolean   @default(true)
  cashOnDeliveryEnabled   Boolean   @default(true)
  transferEnabled         Boolean   @default(true)
  transferAccountName     String?   @db.Text
  transferAccountNumber   String?   @db.Text
  transferBank            String?   @db.Text
  transferReferencePrefix String?   @db.Text
  transferReferenceExtra  String?   @db.Text
  transferInstructions    String?   @db.Text
  isVerified              Boolean   @default(false)
  featuredPosition        Int?      @unique
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  members      StoreMember[]
  drivers      Driver[]
  coupons      StoreCoupon[]
  products     Product[]
  orders       Order[]
  cartItems    CartItem[]
  deliveries   Delivery[]
  subscription StoreSubscription?

  @@map("stores")
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      StoreRole @default(CUSTOMER)
  createdAt DateTime  @default(now())

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model Prospect {
  id                      String           @id @default(cuid())
  businessName            String
  businessNameNormalized  String
  slug                    String?          @unique
  contactName             String?
  phone                   String?
  phoneNormalized         String?
  email                   String?
  emailNormalized         String?
  website                 String?
  websiteNormalized       String?
  facebookUrl             String?
  facebookUrlNormalized   String?
  instagramUrl            String?
  instagramUrlNormalized  String?
  googleMapsUrl           String?
  googleMapsUrlNormalized String?
  address                 String?
  city                    String
  category                String?
  notes                   String?          @db.Text
  source                  ProspectSource   @default(MANUAL)
  status                  ProspectStatus   @default(NEW)
  priority                ProspectPriority @default(MEDIUM)
  assignedToId            String?
  assignedTo              User?            @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactAt           DateTime?
  nextFollowUpAt          DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  activities ProspectActivity[]

  @@index([businessNameNormalized])
  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@index([websiteNormalized])
  @@index([googleMapsUrlNormalized])
  @@index([facebookUrlNormalized])
  @@index([instagramUrlNormalized])
  @@index([city])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@map("prospects")
}

model ProspectActivity {
  id             String                 @id @default(cuid())
  prospectId     String
  prospect       Prospect               @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  channel        ProspectContactChannel @default(OTHER)
  activityType   ProspectActivityType
  comment        String?                @db.Text
  occurredAt     DateTime               @default(now())
  performedById  String
  performedBy    User                   @relation("ProspectActivityActor", fields: [performedById], references: [id], onDelete: Restrict)
  result         String?
  nextFollowUpAt DateTime?
  createdAt      DateTime               @default(now())

  @@index([prospectId, occurredAt])
  @@index([performedById])
  @@index([activityType])
  @@index([channel])
  @@map("prospect_activities")
}

model StoreCoupon {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           CouponType
  value          Float
  minOrderAmount Float?
  maxRedemptions Int?
  redeemedCount  Int        @default(0)
  isActive       Boolean    @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  stripeCouponId String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
  @@map("store_coupons")
}

// ─── Plans & Subscriptions ───────────────────────────────────────────────────

model Plan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  priceMonthly   Float    @default(0)
  priceYearly    Float    @default(0)
  maxProducts    Int?
  maxOrdersMonth Int?
  commissionRate Float    @default(0.05)
  features       Json     @default("{}")
  stripePriceId  String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions StoreSubscription[]

  @@map("plans")
}

model StoreSubscription {
  id                   String             @id @default(cuid())
  storeId              String             @unique
  store                Store              @relation(fields: [storeId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("store_subscriptions")
}

// ─── Categories (global, plataforma) ─────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  image     String?
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  products Product[]

  @@map("categories")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  name           String
  slug           String
  description    String?       @db.Text
  price          Float
  comparePrice   Float?
  stock          Int           @default(0)
  manageStock    Boolean       @default(true)
  sku            String?
  images         String[]
  tags           String[]
  variantOptions Json?
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  views          Int           @default(0)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, storeId, productId])
  @@map("cart_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                    String        @id @default(cuid())
  storeId               String
  store                 Store         @relation(fields: [storeId], references: [id])
  customerId            String?
  customer              User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail         String?
  status                OrderStatus   @default(PENDING)
  subtotal              Float
  platformFee           Float         @default(0)
  total                 Float
  couponId              String?
  coupon                StoreCoupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode            String?
  discountAmount        Float         @default(0)
  customerInfo          Json          @map("shippingAddress")
  notes                 String?       @db.Text
  checkoutToken         String?       @unique
  paymentMethod         PaymentMethod @default(STRIPE)
  transferCode          String?       @unique
  stripePaymentIntentId String?
  stripeSessionId       String?       @unique
  reservationExpiresAt  DateTime?
  paidAt                DateTime?
  whatsappNotifiedAt    DateTime?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items    OrderItem[]
  payment  Payment?
  delivery Delivery?

  @@index([storeId])
  @@index([storeId, customerId])
  @@index([storeId, customerEmail])
  @@index([storeId, status])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Float
  total           Float
  productSnapshot Json

  @@map("order_items")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(cuid())
  storeId               String
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id])
  stripePaymentIntentId String?       @unique
  stripeRefundId        String?       @unique
  amount                Float
  currency              String        @default("mxn")
  platformFee           Float         @default(0)
  status                PaymentStatus @default(PENDING)
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([storeId])
  @@map("payments")
}

model StripeWebhookEvent {
  id                  String    @id @default(cuid())
  stripeEventId       String    @unique
  type                String
  processedAt         DateTime?
  processingStartedAt DateTime?
  error               String?   @db.Text
  createdAt           DateTime  @default(now())

  @@index([type])
  @@map("stripe_webhook_events")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("reviews")
}

// ─── Delivery ──────────────────────────────────────────────────────────────

model Driver {
  id            String       @id @default(cuid())
  storeId       String?
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name          String
  email         String       @unique
  phone         String       @default("")
  plate         String       @default("")
  licenseNumber String       @default("")
  notes         String?      @db.Text
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  deliveries Delivery[]

  @@index([storeId, status])
  @@map("drivers")
}

model Delivery {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId         String?
  driver           Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  method           DeliveryMethod
  status           DeliveryStatus @default(PENDING)
  formattedAddress String?        @db.Text
  lat              Float?
  lng              Float?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([storeId, method])
  @@index([storeId, status])
  @@index([driverId])
  @@map("deliveries")
}

model SocialPost {
  id               String           @id @default(cuid())
  title            String
  topic            String
  channels         String[]
  caption          String           @db.Text
  imageUrl         String?
  destinationUrl   String           @default("https://shop.aionsite.com.mx")
  scheduledAt      DateTime
  status           SocialPostStatus @default(SCHEDULED)
  publishedAt      DateTime?
  facebookPostId   String?
  instagramMediaId String?
  lastError        String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, scheduledAt])
  @@index([publishedAt])
  @@map("social_posts")
}

enum GlobalRole {
  USER
  PLATFORM_ADMIN
}

enum StoreRole {
  OWNER
  STAFF
  CUSTOMER
}

enum ProspectSource {
  MANUAL
  GOOGLE_MAPS
  FACEBOOK
  INSTAGRAM
  REFERRAL
  OTHER
}

enum ProspectContactChannel {
  IN_PERSON
  EMAIL
  PHONE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  OTHER
}

enum ProspectStatus {
  NEW
  PENDING_CONTACT
  CONTACTED
  REPLIED
  FOLLOW_UP
  SECOND_MESSAGE
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  NO_RESPONSE
  DISCARDED
}

enum ProspectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProspectActivityType {
  CREATED
  CONTACT_ATTEMPT
  MESSAGE_SENT
  EMAIL_SENT
  IN_PERSON_VISIT
  PHONE_CALL
  RESPONSE_RECEIVED
  FOLLOW_UP
  MEETING
  PROPOSAL_SENT
  STATUS_CHANGED
  NOTE_ADDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  DELETED
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  CASH_ON_DELIVERY
  TRANSFER
}

enum DeliveryMethod {
  PICKUP
  LOCAL_DELIVERY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  OFFLINE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}
